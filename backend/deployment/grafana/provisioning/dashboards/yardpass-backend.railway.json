      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(yardpass_auth_operations_total{result=\"failure\"}[$__rate_interval])) / sum(rate(yardpass_auth_operations_total[$__rate_interval]))",
