# Railway — copy blocks into each service Variables tab.
# Service names must match: backend, frontend, prometheus, grafana, elasticsearch, jaeger, postgres, redis

# --- backend ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}?sslmode=disable
REDIS_URL=${{Redis.REDIS_PRIVATE_URL}}
JWT_SECRET=<random-secret>
SERVICE_TOKEN=<random-token>
LOG_TRANSPORT=elastic
ELASTIC_URL=http://elasticsearch.railway.internal:9200
TRACER_ENABLED=false
CORS_ALLOWED_ORIGINS=https://yardpass.up.railway.app
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
# Email: Hobby blocks SMTP — use Resend HTTP API (not SMTP_*)
RESEND_API_KEY=re_xxxxxxxx
SMTP_FROM=onboarding@resend.dev

# --- frontend ---
BACKEND_URL=http://${{Backend.RAILWAY_PRIVATE_DOMAIN}}:8080

# --- prometheus ---
PORT=9090

# --- grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<password>
GF_USERS_ALLOW_SIGN_UP=false

# --- bot (optional) ---
# DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}?sslmode=disable
# REDIS_URL=${{Redis.REDIS_PRIVATE_URL}}
# JWT_SECRET=${{Backend.JWT_SECRET}}
# TELEGRAM_BOT_TOKEN=
# LOG_TRANSPORT=stdout
