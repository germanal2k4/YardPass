# Variant of backend/Dockerfile that produces only the Telegram bot binary.
# Used by Railway/single-target build platforms that do not expose Dockerfile
# target selection in the UI. For local docker-compose use the main Dockerfile
# with target=bot.

FROM golang:1.25-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o bot ./cmd/bot

FROM alpine:latest

RUN apk --no-cache add ca-certificates wget

WORKDIR /app

COPY --from=builder /app/bot .
COPY --from=builder /app/config/config.yaml .
COPY --chmod=755 docker-entrypoint.bot.sh /docker-entrypoint.sh

EXPOSE 5050

HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD sh -c 'wget --no-verbose --tries=1 --spider "http://127.0.0.1:${METRICS_PORT:-${PORT:-5050}}/metrics" || exit 1'

ENTRYPOINT ["/docker-entrypoint.sh"]
