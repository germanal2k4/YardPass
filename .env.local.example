# Local development (docker compose). Copy to .env and adjust.
# Start: docker compose -f docker-compose.data.yml up -d && docker compose up -d

JWT_SECRET=dev-secret-change-me
SERVICE_TOKEN=dev-service-token

# Optional overrides (defaults in docker-compose.yml work out of the box)
# DATABASE_URL=postgres://yardpass:password@localhost:5432/yardpass?sslmode=disable
# REDIS_URL=redis://localhost:6379/0

# Mail — MailHog UI http://localhost:8025
# SMTP_HOST=mailhog
# SMTP_PORT=1025
# SMTP_FROM=noreply@yardpass.local

# Logs & tracing (stack from docker-compose)
# LOG_TRANSPORT=elastic
# ELASTIC_URL=http://elasticsearch:9200
# TRACER_ENABLED=true
# TRACER_URL=jaeger:4317

# Telegram bot (profile: bot)
# TELEGRAM_BOT_TOKEN=
