# Railway — copy blocks into each service Variables tab.
# Service names must match: backend, frontend, prometheus, grafana, elasticsearch, jaeger, postgres, redis

# --- backend ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}?sslmode=disable
REDIS_URL=${{Redis.REDIS_PRIVATE_URL}}
JWT_SECRET=<random-secret>
SERVICE_TOKEN=<random-token>
LOG_TRANSPORT=elastic
ELASTIC_URL=http://elasticsearch.railway.internal:9200
TRACER_ENABLED=false
CORS_ALLOWED_ORIGINS=https://yardpass.up.railway.app
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
# Email: Hobby blocks SMTP — use Resend HTTP API (not SMTP_*)
RESEND_API_KEY=re_xxxxxxxx
SMTP_FROM=onboarding@resend.dev

# --- frontend ---
BACKEND_URL=http://${{Backend.RAILWAY_PRIVATE_DOMAIN}}:8080

# --- prometheus ---
PORT=9090
BACKEND_SCRAPE_HOST=backend
BACKEND_SCRAPE_PORT=8080
# Railway private DNS: <slug>.railway.internal — slug must match the bot service name in the project (not always "bot").
BOT_SCRAPE_HOST=bot
BOT_SCRAPE_PORT=5050
# If bot metrics use another port, set BOT_SCRAPE_PORT (e.g. reference ${{Bot.PORT}} when METRICS_PORT is unset on the bot).

# --- bot ---
# TELEGRAM_BOT_TOKEN=...
# JWT_SECRET=${{Backend.JWT_SECRET}}
# DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}?sslmode=disable
# REDIS_URL=${{Redis.REDIS_PRIVATE_URL}}
# METRICS_ENABLED=true
# Either set METRICS_PORT=5050 and add PORT=5050 in Railway for this service, or leave METRICS_PORT unset
# so the app uses Railway $PORT for the metrics HTTP server (then set BOT_SCRAPE_PORT on prometheus).

# --- grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<password>
GF_USERS_ALLOW_SIGN_UP=false
